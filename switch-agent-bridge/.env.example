# Switch agent bridge (normally the local Switch server started by Switch Console)
SWITCH_BASE_URL=http://127.0.0.1:61512

# Optional for Switch Console on Windows: setup securely reads the local server's
# existing registration token when this is blank. Remote Switch servers require it.
SWITCH_REGISTRATION_TOKEN=

# Demo configuration
SWITCHFLOW_PREFIX=switchflow-live
SWITCHFLOW_ROOM_NAME=switchflow-live-demo
SWITCHFLOW_BUSINESS=restaurant
SWITCHFLOW_GOAL=Reduce tomorrow's avoidable food waste without causing stock-outs.
SWITCHFLOW_SUCCESS_METRIC=Produce an approved purchasing adjustment with clear evidence and verification.
SWITCHFLOW_APPROVAL_PHRASE=APPROVE

# Optional. Setup chooses the first Mattermost bridge when this is blank.
SWITCH_BRIDGE_ID=

# Optional Codex model override. Blank uses the signed-in Codex default.
CODEX_MODEL=

# Local website + API address: http://127.0.0.1:8787
SWITCHFLOW_WEB_PORT=8787

